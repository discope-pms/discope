{
    "name": "Guest List Item List",
    "description": "This view is intended for displaying the list of guest list items.",
    "header": {
        "actions": {
            "ACTION.CREATE": false
        }
    },
    "actions": [
        {
            "id": "action.export",
            "label": "Export",
            "description": "Export the guest list items in a CSV file.",
            "controller": "sale_booking_guests_export-guest-list-items",
            "confirm": false
        }
    ],
    "access": {
        "groups": ["booking.default.user"]
    },
    "controller": "sale_booking_guests_collect-guest-list-items",
    "group_by": [
        {
            "open": true,
            "field": "center_id"
        }
    ],
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "center_id",
                "width": "20%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "booking_id",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "booking_line_group_id",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "date_from",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "date_to",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "lastname",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "firstname",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "is_coordinator",
                "width": "20%",
                "sort": false
            },
            {
                "type": "field",
                "value": "gender",
                "width": "10%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "date_of_birth",
                "width": "15%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "citizen_identification",
                "width": "15%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "address_street",
                "width": "20%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "address_zip",
                "width": "10%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "address_city",
                "width": "10%",
                "visible": false,
                "sort": false
            },
            {
                "type": "field",
                "value": "address_country",
                "width": "10%",
                "visible": false,
                "sort": false
            }
        ]
    }
}
